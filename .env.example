# Development template; copy to .env and change passwords before starting databases.
# Default local persistence needs neither Docker nor Redis.
CROP_TWIN_ENVIRONMENT=local
CROP_TWIN_LOG_LEVEL=INFO
CROP_TWIN_DATABASE_URL=sqlite:///./runtime/crop_twin.db
# Local HTTP only; HTTPS requires true plus the M7 deployment gate.
CROP_TWIN_COOKIE_SECURE=false
# JSON array; match actual browser origins. Default also allows localhost and API /docs.
# CROP_TWIN_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://127.0.0.1:8000"]
# Account passwords are set interactively, never stored here.
# PostgreSQL alternative (URL-encode the password):
# CROP_TWIN_DATABASE_URL=postgresql+psycopg://crop_twin:URL_ENCODED_PASSWORD@127.0.0.1:5432/crop_twin
POSTGRES_DB=crop_twin
POSTGRES_USER=crop_twin
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
REDIS_PASSWORD=replace-with-local-redis-password
REDIS_PORT=6379
